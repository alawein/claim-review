{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alawein/claim-review/schema/stress.v1.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "text", "start_codepoint", "end_codepoint"],
    "properties": {
      "id": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "start_codepoint": {
        "type": "integer",
        "minimum": 0
      },
      "end_codepoint": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
