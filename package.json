{
  "name": "claim-review",
  "version": "0.3.1",
  "description": "Review citations with exact spans and explicit human rationales.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run build",
    "fix": "eslint . --fix && prettier --write .",
    "test:browser": "playwright test",
    "validate:schema": "node scripts/validate-schema.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.63.0",
    "@types/jsonld": "1.5.15",
    "@types/node": "26.6.3",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "4.10.2",
    "jsonld": "9.0.0",
    "prettier": "^3.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "files": [
    "dist/index.html",
    "schema/",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alawein/claim-review.git"
  }
}
