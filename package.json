{
  "name": "claim-review",
  "version": "0.1.0",
  "description": "Review citations with exact spans and explicit human rationales.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm test && npm run build",
    "fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.0.3",
    "esbuild": "0.28.2",
    "@playwright/test": "1.63.0"
  }
}
