{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs",
      "startServerReadyPattern": "4173",
      "url": ["http://127.0.0.1:4173"],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox --disable-dev-shm-usage" }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "benchmarks/artifacts/lighthouse" }
  }
}
